# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA comite o arquivo ".env" (com valores reais) no Git — apenas este ".env.example".

# --- Aplicação ---
ENVIRONMENT=development
DEBUG=true

# --- PostgreSQL: usuário BOOTSTRAP/SUPERUSER (criado pela imagem oficial do Postgres) ---
# Usado SÓ para rodar migrações (alembic). NUNCA usado pela aplicação em
# runtime — superusuário sempre ignora Row-Level Security, mesmo com FORCE.
POSTGRES_USER=campanhaos
POSTGRES_PASSWORD=troque_esta_senha_localmente
POSTGRES_DB=campanhaos
MIGRATION_DATABASE_URL=postgresql+asyncpg://campanhaos:troque_esta_senha_localmente@postgres:5432/campanhaos

# --- PostgreSQL: usuário de APLICAÇÃO (sem superuser, respeita RLS) ---
# Criado pela migração 0002_create_app_role. A senha aqui precisa bater
# com a mesma variável que a migração usa para criar o usuário.
APP_DB_PASSWORD=troque_esta_outra_senha_localmente
DATABASE_URL=postgresql+asyncpg://campanhaos_app:troque_esta_outra_senha_localmente@postgres:5432/campanhaos
DATABASE_ECHO_SQL=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Autenticação (Módulo 1 em diante) ---
# Gere uma chave forte real com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=gere_uma_chave_forte_e_unica_aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Observabilidade (opcional em desenvolvimento) ---
SENTRY_DSN=

# --- CORS em produção (não usada em desenvolvimento) ---
# URL completa do frontend implantado, ex: https://app.campanhaos.com.br
# ou a URL padrão do Railway (https://SEU-APP.up.railway.app).
FRONTEND_URL=

# --- Geocodificação (Mapbox) ---
# Opcional: sem essa variável, eleitores são criados normalmente, só
# sem coordenada automática (sem mapa de endereço até que seja preenchido
# manualmente ou esta variável seja configurada).
MAPBOX_ACCESS_TOKEN=
